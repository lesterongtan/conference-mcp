# Production database. SQLite remains available for local development.
CONFERENCE_SCOUT_DATABASE_URL=
CONFERENCE_SCOUT_DATABASE_SCHEMA=conference_scout
CONFERENCE_SCOUT_DB=./conference-scout.db
CONFERENCE_SCOUT_AUTO_CREATE_SCHEMA=true

# Hosted authentication. Use a unique long random bootstrap key and pepper.
CONFERENCE_SCOUT_REQUIRE_AUTH=false
CONFERENCE_SCOUT_BOOTSTRAP_CUSTOMER_ID=local
CONFERENCE_SCOUT_BOOTSTRAP_API_KEY=
CONFERENCE_SCOUT_API_KEY_PEPPER=
CONFERENCE_SCOUT_PUBLIC_URL=http://127.0.0.1:8765
CONFERENCE_SCOUT_CORS_ORIGINS=

# API and worker runtime.
CONFERENCE_SCOUT_HTTP_HOST=127.0.0.1
CONFERENCE_SCOUT_HTTP_PORT=8765
CONFERENCE_SCOUT_USER_AGENT=ConferenceScoutMCP/0.1 (+https://speakeragent.ai)
CONFERENCE_SCOUT_EMBEDDED_WORKER=true
CONFERENCE_SCOUT_WORKER_POLL_SECONDS=1
CONFERENCE_SCOUT_WORKER_LEASE_SECONDS=1800
CONFERENCE_SCOUT_SEARCH_DAILY_LIMIT=100
CONFERENCE_SCOUT_ENRICHMENT_DAILY_LIMIT=100
CONFERENCE_SCOUT_MAX_RESPONSE_BYTES=2000000
CONFERENCE_SCOUT_DISCOVERY_MAX_PAGES=40
CONFERENCE_SCOUT_DISCOVERY_MAX_CONCURRENT=8
CONFERENCE_SCOUT_WORKER_HEARTBEAT_SECONDS=30

# Discovery and contact-enrichment providers.
SERPER_API_KEY=
APIFY_API_TOKEN=
# APIFY_API_KEY is accepted as an alias when that is the name already in use.
CFP_DIRECTORY_APIFY_ACTOR_ID=zen-studio~10times-events-scraper
CFP_DIRECTORY_APIFY_MAX_CHARGE_USD=1.00
CFP_DIRECTORY_APIFY_MAX_KEYWORDS=3
CFP_DIRECTORY_APIFY_MAX_POLL_SECONDS=240
# Required only when using an actor other than the verified default actor.
CFP_DIRECTORY_APIFY_INPUT_TEMPLATE=
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_PAGES=3
CONTACT_FINDER_URL=
CONTACT_FINDER_TOKEN=
CONTACT_FINDER_SEARCH_FIRST_ENABLED=true
CONTACT_FINDER_POLL_SECONDS=4
CONTACT_FINDER_TIMEOUT_SECONDS=400
CONTACT_FINDER_SEARCH_FIRST_TIMEOUT_SECONDS=150
CONTACT_FINDER_MAX_CONCURRENT=2

# Disabled until the colleague-owned service is approved for this use.
EXTERNAL_SUPER_BROWSER_MCP_URL=
EXTERNAL_SUPER_BROWSER_TOKEN=
